        ],
        "url": {
          "raw": "{{baseUrl}}/api/audit/cases.csv?from=2026-01-01T00:00:00Z&to=2026-12-31T00:00:00Z&includePii=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "audit",
            "cases.csv"
          ],
          "query": [
