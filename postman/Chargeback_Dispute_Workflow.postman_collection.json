{
  "info": {
    "name": "Chargeback / Dispute Workflow",
    "_postman_id": "6c2c8a2d-1e86-4b02-9f63-2cbb0a1c1111",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "caseId",
      "value": ""
    },
    {
      "key": "attachmentId",
      "value": ""
    },
    {
      "key": "piiKeyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Issue Token (demo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "token"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"alice\",\n  \"team\": \"CHARGEBACK\",\n  \"roles\": [\n    \"DISPUTE_VIEW\",\n    \"DISPUTE_EDIT\"\n  ]\n}"
        }
      }
    },
    {
      "name": "Open Case",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalRef\": \"cb-123\",\n  \"customerRef\": \"customer@example.com\",\n  \"amountCents\": 1999,\n  \"currency\": \"USD\",\n  \"assignedTeam\": \"CHARGEBACK\",\n  \"description\": \"Customer disputes card-not-present transaction\"\n}"
        }
      }
    },
    {
      "name": "Get Case",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}"
          ]
        }
      }
    },
    {
      "name": "Change State -> UNDER_REVIEW",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/state",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "state"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetState\": \"UNDER_REVIEW\",\n  \"note\": \"Evidence received, start review\"\n}"
        }
      }
    },
    {
      "name": "Register Attachment Metadata",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/attachments/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "attachments",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"evidence.pdf\",\n  \"contentType\": \"application/pdf\",\n  \"sizeBytes\": 123456,\n  \"sha256\": \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\n}"
        }
      }
    },
    {
      "name": "Audit History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/audit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "audit"
          ]
        }
      }
    },
    {
      "name": "Presign Attachment Upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/attachments/presign-upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "attachments",
            "presign-upload"
          ]
        },
        "description": "Generates a presigned upload URL and stores attachment metadata.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"evidence.pdf\",\n  \"contentType\": \"application/pdf\",\n  \"sizeBytes\": 1234,\n  \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
        }
      }
    },
    {
      "name": "Presign Attachment Download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/attachments/{{attachmentId}}/presign-download",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "attachments",
            "{{attachmentId}}",
            "presign-download"
          ]
        },
        "description": "Generates a presigned download URL for an existing attachment."
      }
    },
    {
      "name": "Update Encrypted PII",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/pii",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "pii"
          ]
        },
        "description": "Updates PII envelope (requires DISPUTE_PII_VIEW + edit).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pii\": {\n    \"email\": \"john@example.com\",\n    \"fullName\": \"John Doe\",\n    \"phone\": \"+48123456789\"\n  },\n  \"note\": \"Add customer contact for investigation\"\n}"
        }
      }
    },
    {
      "name": "Set Legal Hold (admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{caseId}}/legal-hold",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cases",
            "{{caseId}}",
            "legal-hold"
          ]
        },
        "description": "Prevents PII purge by retention job.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"legalHold\": true,\n  \"note\": \"Regulatory hold\"\n}"
        }
      }
    },
    {
      "name": "Export Cases CSV (auditor)",
      "request": {
        "method": "GET",
        "header": [
