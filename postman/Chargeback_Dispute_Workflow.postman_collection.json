    {
      "name": "Admin PII Re-encryption",
      "item": [
        {
          "name": "Schedule re-encrypt job (dry-run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/crypto/pii-keys/reencrypt-jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldKid\": \"k2025-06\",\n  \"newKid\": \"k2026-01\",\n  \"batchSize\": 50,\n  \"delayMs\": 100,\n  \"dryRun\": true\n}"
            }
          }
        },
        {
          "name": "Schedule re-encrypt job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/crypto/pii-keys/reencrypt-jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldKid\": \"k2025-06\",\n  \"newKid\": \"k2026-01\",\n  \"batchSize\": 50,\n  \"delayMs\": 100,\n  \"dryRun\": false\n}"
